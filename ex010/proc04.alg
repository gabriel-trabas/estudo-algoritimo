algoritmo "fibo do procedimento"
var
  calc,t1,t2:inteiro
procedimento fibo(var a,b:inteiro)

  var
    c:inteiro
  inicio
   c:= a+b
   escreva(c)
   a:= b
   b:=c


  fimprocedimento
inicio
  t1<-0
  escreva(t1)
  t2<-1
   escreva(t2)
  para calc de 1 ate 10 faca 
  fibo(t1,t2)
 fimpara 
fimalgoritmo