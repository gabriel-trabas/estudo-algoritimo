algoritmo "transferencia de alma"
var
   x,y:inteiro
   procedimento trans(var a,b:inteiro )

   inicio
     a<- a+1
     b<-b+2
     escreval("o valor da soma é : ",a+b)
   fimprocedimento
inicio
x<-8
y<-5
  trans(x,y)

  escreval("o valor de x é ",x)
  escreval("o valor de y é ",y)



fimalgoritmo
