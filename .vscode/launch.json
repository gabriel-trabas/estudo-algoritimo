    "version": "0.2.0",
    "configurations": [
        {
            "type": "delegua",
            "request": "launch",
            "name": "VisuAlg - passo a passo",
            "program": "${file}",
            "stopOnEntry": true,
            "internalConsoleOptions": "neverOpen"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Executar VisuAlg no terminal",
            "runtimeExecutable": "C:/Users/faria/Documents/Codex/tools/visualg/node/node.exe",
            "program": "C:/Users/faria/Documents/Codex/tools/visualg/executar.cjs",
            "args": [
                "--dialeto",
                "visualg",
                "${file}"
            ],
            "cwd": "${fileDirname}",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "type": "delegua",
            "request": "launch",
            "name": "Executar arquivo aberto",
            "program": "${file}",
            "stopOnEntry": false
        }
    ]
}
