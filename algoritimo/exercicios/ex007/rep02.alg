algoritmo "UsuarioSaltador"
var
  contador,valor,salto:inteiro
inicio
escreva("quer contar até quanto?")
leia(valor)
escreva("qual o valor do salto")
leia(salto)
contador<-0
  enquanto (contador<=valor)faca
  escrevaL(contador)
   contador<- contador +salto
  fimenquanto
  escreval("terminei de contar")

 
fimalgoritmo