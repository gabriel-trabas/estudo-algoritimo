algoritmo "NomeDoAlgoritmo"
var
   ano,nasc,idade:inteiro
inicio
  escreva("em que ano estamos")
    leia(ano)
  escreva("em que ano você nasceu?")
    leia(nasc)
  idade<- ano-nasc
  escreva("em ",ano, "voce terá? ", idade )
  se (idade>=18) entao
    escreval ("Já terá atingido a maior idade")
  senao
  
  FimSE
fimalgoritmo